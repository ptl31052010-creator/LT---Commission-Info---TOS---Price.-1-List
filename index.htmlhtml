<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Linh Thuỳ — Commission Info - TOS - Price List 🌸</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load Nunito and Quicksand fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Load FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Nunito', 'sans-serif'],
                        display: ['Quicksand', 'sans-serif'],
                    },
                    colors: {
                        pastel: {
                            50: '#FFF5F8',
                            100: '#FFE8F0',
                            200: '#FFD1E1',
                            300: '#FFACC9',
                            400: '#FF7AA8',
                            500: '#F4538A',
                            600: '#D93870',
                        },
                        cream: '#FFFDFB',
                        cocoa: '#5C474E',
                    },
                    boxShadow: {
                        'soft': '0 10px 30px -5px rgba(244, 83, 138, 0.12)',
                        'card': '0 4px 20px -2px rgba(255, 172, 201, 0.25)',
                    }
                }
            }
        }
    </script>

    <style>
        /* Soft pink dot-patterned pastel background */
        body {
            background-color: #FFF5F8;
            background-image:
                radial-gradient(#FFD1E1 1.5px, transparent 1.5px),
                radial-gradient(#FFE8F0 1.5px, #FFF5F8 1.5px);
            background-size: 36px 36px;
            background-position: 0 0, 18px 18px;
            color: #5C474E;
        }

        /* Floating decorative animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-6px) rotate(5deg); }
        }
        .animate-float { animation: float 3.5s ease-in-out infinite; }
        .animate-float-delay { animation: float 4s ease-in-out 1.5s infinite; }

        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #FFF5F8; }
        ::-webkit-scrollbar-thumb { background: #FFACC9; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #FF7AA8; }

        /* Hide default details disclosure arrow */
        details summary::-webkit-details-marker { display: none; }
    </style>
</head>
<body class="min-h-screen antialiased selection:bg-pastel-200 selection:text-pastel-600 pb-16">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transform transition-all duration-300 translate-y-20 opacity-0 pointer-events-none">
        <div class="bg-pastel-500 text-white px-5 py-3 rounded-full shadow-lg flex items-center gap-2.5 text-sm font-bold">
            <i class="fa-solid fa-heart animate-pulse"></i>
            <span id="toast-msg">Đã sao chép thành công!</span>
        </div>
    </div>

    <main class="max-w-3xl mx-auto px-4 pt-8 sm:pt-12 space-y-8">

        <!-- OWNER CONTROL PANEL (HIDDEN FOR VISITORS; UNLOCKED VIA PIN 3105) -->
        <div id="owner-panel" class="hidden bg-cream/95 backdrop-blur-sm rounded-[2rem] p-4 sm:p-5 shadow-soft border-2 border-pastel-300 space-y-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-pastel-100">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-full bg-pastel-100 text-pastel-600 flex items-center justify-center text-xs font-bold">👑</span>
                    <span class="font-display font-bold text-sm text-cocoa">Chế độ chủ trang — Linh Thuỳ</span>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" onclick="resetDefaultPrices()" class="text-xs font-bold px-3 py-1 rounded-full bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 transition-colors cursor-pointer">
                        <i class="fa-solid fa-rotate-left mr-1"></i>Khôi phục giá gốc
                    </button>
                    <button type="button" onclick="openChangePinModal()" class="text-xs font-bold px-3 py-1 rounded-full bg-pastel-50 hover:bg-pastel-100 text-pastel-600 border border-pastel-200 transition-colors cursor-pointer">
                        <i class="fa-solid fa-key mr-1"></i>Đổi mã PIN
                    </button>
                    <button type="button" onclick="lockOwnerMode()" class="text-xs font-bold px-3 py-1 rounded-full bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 transition-colors cursor-pointer">
                        <i class="fa-solid fa-lock mr-1"></i>Khoá lại
                    </button>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-bold text-cocoa/70 mr-1">Đổi trạng thái:</span>
                <button type="button" onclick="setStatus('open')" id="owner-btn-open" class="px-3.5 py-1.5 rounded-full text-xs font-display font-bold border transition-all cursor-pointer bg-white border-pastel-200 text-cocoa hover:bg-pastel-50">
                    OPEN 🌸
                </button>
                <button type="button" onclick="setStatus('waitlist')" id="owner-btn-waitlist" class="px-3.5 py-1.5 rounded-full text-xs font-display font-bold border transition-all cursor-pointer bg-white border-pastel-200 text-cocoa hover:bg-pastel-50">
                    WAITLIST ⏳
                </button>
                <button type="button" onclick="setStatus('closed')" id="owner-btn-closed" class="px-3.5 py-1.5 rounded-full text-xs font-display font-bold border transition-all cursor-pointer bg-white border-pastel-200 text-cocoa hover:bg-pastel-50">
                    CLOSED 💤
                </button>
            </div>

            <div class="bg-pastel-50/80 rounded-2xl p-3.5 border border-pastel-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                <p class="text-xs text-cocoa/80 leading-relaxed">
                    <strong class="text-pastel-600">Chỉnh giá &amp; chia sẻ:</strong> Bấm trực tiếp vào bất kỳ ô giá nào trong mục <strong>Bảng giá</strong> để sửa. Bấm nút bên cạnh để sao chép đường dẫn đã đóng gói cả <strong>trạng thái + bảng giá mới</strong> gửi cho khách nhé!
                </p>
                <button type="button" onclick="copyShareableConfigLink()" class="shrink-0 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-pastel-500 hover:bg-pastel-600 text-white font-display font-bold text-xs shadow-sm transition-all cursor-pointer">
                    <i class="fa-solid fa-link"></i>
                    <span>Sao chép link trạng thái &amp; giá</span>
                </button>
            </div>
        </div>

        <!-- HEADER -->
        <header class="relative bg-cream/95 backdrop-blur-sm rounded-[2rem] p-6 sm:p-8 shadow-soft border-2 border-pastel-200 text-center overflow-hidden">
            <div id="secret-sparkle" class="absolute top-4 left-5 text-pastel-300 text-xl animate-float select-none cursor-default">✦</div>
            <div class="absolute top-6 right-7 text-pastel-300 text-lg animate-float-delay select-none">♡</div>
            <div class="absolute bottom-4 left-8 text-pastel-200 text-lg select-none">✿</div>
            <div class="absolute bottom-5 right-6 text-pastel-300 text-xl animate-float select-none">✧</div>

            <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-cocoa tracking-tight">
                Linh Thuỳ
            </h1>
            <p class="text-xs sm:text-sm font-semibold text-pastel-600 mt-1">
                Trang Facebook: <span class="font-bold">LT's Art Corner</span> • TikTok: <span class="font-bold">Ena</span>
            </p>
            <p class="text-sm sm:text-base text-cocoa/80 mt-2 max-w-md mx-auto leading-relaxed">
                Chào mừng cậu đến với góc nhỏ nhận vẽ commission của Linh Thuỳ ♡ Cảm ơn cậu đã ghé thăm và ủng hộ nét vẽ của mình nhé!
            </p>

            <!-- COMMISSION STATUS BADGE (STATIC FOR VISITORS; ONLY OWNER CAN EDIT) -->
            <div class="mt-4 flex flex-col items-center">
                <div
                    id="status-badge"
                    class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pastel-100 border border-pastel-300 text-pastel-600 font-display font-bold text-sm shadow-sm select-none"
                >
                    <span id="status-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                    <span id="status-text">COMMISSION: OPEN 🌸</span>
                </div>
            </div>

            <div class="flex flex-wrap justify-center gap-2.5 mt-5">
                <a href="#order-section" onclick="showPage('order-section'); return false;" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-pastel-400 hover:bg-pastel-500 text-white text-sm font-bold shadow-sm transition-all hover:-translate-y-0.5">
                    <i class="fa-brands fa-facebook-messenger"></i> Đặt đơn / Nhắn tin
                </a>
                <a href="https://www.facebook.com/share/1A7BTdXFg2/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white hover:bg-pastel-50 text-cocoa border border-pastel-200 text-sm font-bold shadow-sm transition-all hover:-translate-y-0.5">
                    <i class="fa-brands fa-facebook text-pastel-500"></i> Facebook
                </a>
                <a href="https://zalo.me/0965753596" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white hover:bg-pastel-50 text-cocoa border border-pastel-200 text-sm font-bold shadow-sm transition-all hover:-translate-y-0.5">
                    <i class="fa-brands fa-comment-dots text-pastel-500"></i> Zalo
                </a>
            </div>

            <p class="mt-6 text-xs text-cocoa/50">Chọn một mục bên dưới để xem nội dung chi tiết nhé ♡</p>
        </header>

        <!-- HOME MENU -->
        <section id="home-menu" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <button type="button" onclick="showPage('price-section')" class="group text-left bg-cream/95 rounded-[2rem] p-6 border-2 border-pastel-200 shadow-soft hover:-translate-y-1 hover:border-pastel-400 transition-all cursor-pointer">
                <span class="text-3xl">🌷</span>
                <h2 class="font-display text-lg font-bold text-cocoa mt-3">Bảng giá</h2>
                <p class="text-sm text-cocoa/65 mt-1">Chibi, Normal, ưu đãi và tranh mẫu Google Drive</p>
                <span class="inline-block mt-4 text-sm font-bold text-pastel-500">Khám phá →</span>
            </button>
            <button type="button" onclick="showPage('tos-section')" class="group text-left bg-cream/95 rounded-[2rem] p-6 border-2 border-pastel-200 shadow-soft hover:-translate-y-1 hover:border-pastel-400 transition-all cursor-pointer">
                <span class="text-3xl">📜</span>
                <h2 class="font-display text-lg font-bold text-cocoa mt-3">Điều khoản</h2>
                <p class="text-sm text-cocoa/65 mt-1">Điều khoản dịch vụ, thanh toán và quy định chỉnh sửa</p>
                <span class="inline-block mt-4 text-sm font-bold text-pastel-500">Đọc điều khoản →</span>
            </button>
            <button type="button" onclick="showPage('order-section')" class="group text-left bg-cream/95 rounded-[2rem] p-6 border-2 border-pastel-200 shadow-soft hover:-translate-y-1 hover:border-pastel-400 transition-all cursor-pointer">
                <span class="text-3xl">💌</span>
                <h2 class="font-display text-lg font-bold text-cocoa mt-3">Đặt commission</h2>
                <p class="text-sm text-cocoa/65 mt-1">Điền thông tin và gửi đơn trực tiếp</p>
                <span class="inline-block mt-4 text-sm font-bold text-pastel-500">Tạo đơn →</span>
            </button>
        </section>

        <!-- PRICE SECTION -->
        <section id="price-section" class="hidden bg-cream/95 backdrop-blur-sm rounded-[2rem] p-6 sm:p-8 shadow-soft border-2 border-pastel-200">
            <button type="button" onclick="showHome()" class="mb-5 inline-flex items-center gap-2 text-sm font-bold text-pastel-600 hover:text-pastel-500 cursor-pointer">← Về trang chủ</button>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-pastel-100">
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-pastel-400">Danh mục gói vẽ</span>
                    <h2 class="font-display text-2xl font-bold text-cocoa flex items-center gap-2">
                        Bảng Giá Chi Tiết <span class="text-xl">🍰</span>
                    </h2>
                </div>
                <span id="price-mode-badge" class="self-start sm:self-auto text-xs font-semibold text-pastel-600 bg-pastel-100 px-3.5 py-1.5 rounded-full border border-pastel-200">
                    Bảng giá cố định • Đơn vị: VNĐ
                </span>
            </div>

            <div class="flex items-center gap-2 mt-5 bg-pastel-50 p-1.5 rounded-2xl border border-pastel-100">
                <button type="button" onclick="filterPrices('all')" id="tab-all" class="filter-tab flex-1 py-2 px-3 rounded-xl font-display font-bold text-sm bg-white text-pastel-600 shadow-sm transition-all cursor-pointer">
                    Tất cả
                </button>
                <button type="button" onclick="filterPrices('chibi')" id="tab-chibi" class="filter-tab flex-1 py-2 px-3 rounded-xl font-display font-bold text-sm text-cocoa/70 hover:text-pastel-600 transition-all cursor-pointer">
                    Chibi 🧸
                </button>
                <button type="button" onclick="filterPrices('normal')" id="tab-normal" class="filter-tab flex-1 py-2 px-3 rounded-xl font-display font-bold text-sm text-cocoa/70 hover:text-pastel-600 transition-all cursor-pointer">
                    Normal ✨
                </button>
            </div>

            <div id="price-container" class="mt-6 space-y-8">
                <!-- CHIBI -->
                <div id="block-chibi" class="space-y-5">
                    <div class="flex items-center justify-between">
                        <h3 class="font-display text-xl font-bold text-pastel-600 flex items-center gap-2">
                            <span class="w-7 h-7 rounded-full bg-pastel-100 flex items-center justify-center text-sm">🧸</span>
                            1. Gói Chibi
                        </h3>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Chibi loại 1 -->
                        <div class="bg-white rounded-3xl p-5 border border-pastel-200 shadow-card">
                            <div class="flex items-center justify-between mb-3 pb-2 border-b border-pastel-100">
                                <h4 class="font-display font-bold text-base text-cocoa">Chibi loại 1</h4>
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-pastel-100 text-pastel-600">1 - 1,5 đầu</span>
                            </div>
                            <div class="space-y-2 text-sm">
                                <div class="flex justify-between items-center py-1">
                                    <span class="text-cocoa/80 font-medium">• Đi nét (Lineart)</span>
                                    <span class="price-cell font-bold text-pastel-600" data-price-key="c1_line">30k</span>
                                </div>
                                <div class="flex justify-between items-center py-1">
                                    <span class="text-cocoa/80 font-medium">• Tô màu phẳng (Flat colors)</span>
                                    <span class="price-cell font-bold text-pastel-600" data-price-key="c1_flat">45k</span>
                                </div>
                                <div class="flex justify-between items-center py-1">
                                    <span class="text-cocoa/80 font-medium">• Hoàn thiện đầy đủ (Rendered)</span>
                                    <span class="price-cell font-bold text-pastel-600" data-price-key="c1_rend">60k</span>
                                </div>
                            </div>
                        </div>

                        <!-- Chibi loại 2 -->
                        <div class="bg-white rounded-3xl p-5 border border-pastel-200 shadow-card">
                            <div class="flex items-center justify-between mb-3 pb-2 border-b border-pastel-100">
                                <h4 class="font-display font-bold text-base text-cocoa">Chibi loại 2</h4>
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-pastel-100 text-pastel-600">2 đầu</span>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm text-left">
                                    <thead>
                                        <tr class="text-[11px] uppercase text-cocoa/50 border-b border-pastel-50">
                                            <th class="pb-1.5 font-bold">Khung hình</th>
                                            <th class="pb-1.5 text-center font-bold">Lineart</th>
                                            <th class="pb-1.5 text-center font-bold">Flat</th>
                                            <th class="pb-1.5 text-center font-bold">Rendered</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-pastel-50">
                                        <tr>
                                            <td class="py-2 font-semibold text-cocoa">Nửa người (Half body)</td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c2_hb_line">25k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c2_hb_flat">45k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c2_hb_rend">65k</span></td>
                                        </tr>
                                        <tr>
                                            <td class="py-2 font-semibold text-cocoa">Toàn thân (Full body)</td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c2_fb_line">40k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c2_fb_flat">65k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c2_fb_rend">85k</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Chibi loại 3 -->
                        <div class="bg-white rounded-3xl p-5 border border-pastel-200 shadow-card">
                            <div class="flex items-center justify-between mb-3 pb-2 border-b border-pastel-100">
                                <h4 class="font-display font-bold text-base text-cocoa">Chibi loại 3</h4>
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-pastel-100 text-pastel-600">3 - 4 đầu</span>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm text-left">
                                    <thead>
                                        <tr class="text-[11px] uppercase text-cocoa/50 border-b border-pastel-50">
                                            <th class="pb-1.5 font-bold">Khung hình</th>
                                            <th class="pb-1.5 text-center font-bold">Lineart</th>
                                            <th class="pb-1.5 text-center font-bold">Flat</th>
                                            <th class="pb-1.5 text-center font-bold">Rendered</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-pastel-50">
                                        <tr>
                                            <td class="py-2 font-semibold text-cocoa">Ngang ngực (Bust up)</td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_bu_line">30k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_bu_flat">45k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_bu_rend">60k</span></td>
                                        </tr>
                                        <tr>
                                            <td class="py-2 font-semibold text-cocoa">Nửa người (Half body)</td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_hb_line">40k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_hb_flat">50k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_hb_rend">75k</span></td>
                                        </tr>
                                        <tr>
                                            <td class="py-2 font-semibold text-cocoa">Toàn thân (Full body)</td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_fb_line">55k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_fb_flat">70k</span></td>
                                            <td class="py-2 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c3_fb_rend">110k</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Chibi loại 4 -->
                        <div class="bg-white rounded-3xl p-5 border border-pastel-200 shadow-card">
                            <div class="flex items-center justify-between mb-3 pb-2 border-b border-pastel-100">
                                <h4 class="font-display font-bold text-base text-cocoa">Chibi loại 4</h4>
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-pastel-100 text-pastel-600">4,5 - 5 đầu</span>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm text-left">
                                    <thead>
                                        <tr class="text-[11px] uppercase text-cocoa/50 border-b border-pastel-50">
                                            <th class="pb-1.5 font-bold">Khung hình</th>
                                            <th class="pb-1.5 text-center font-bold">Lineart</th>
                                            <th class="pb-1.5 text-center font-bold">Flat</th>
                                            <th class="pb-1.5 text-center font-bold">Rendered</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-pastel-50">
                                        <tr>
                                            <td class="py-1.5 font-semibold text-cocoa">Ngang vai (Headshot)</td>
                                            <td class="py-1.5 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c4_hs_line">25k</span></td>
                                            <td class="py-1.5 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c4_hs_flat">40k</span></td>
                                            <td class="py-1.5 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c4_hs_rend">60k</span></td>
                                        </tr>
                                        <tr>
                                            <td class="py-1.5 font-semibold text-cocoa">Ngang ngực (Bust up)</td>
                                            <td class="py-1.5 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c4_bu_line">35k</span></td>
                                            <td class="py-1.5 text-center"><span class="price-cell font-bold text-pastel-600" data-price-key="c4_bu_flat">50k</span></td>
