                <p class="text-sm text-cocoa/75 mt-1">
                    Điền thông tin rồi bấm <strong>Hoàn tất</strong> — đơn sẽ gửi thẳng về Gmail của mình nhé!
                </p>
            </div>

            <form id="comm-form" action="https://formspree.io/f/mnpddqwr" method="POST" class="mt-6 space-y-4">
                <input type="hidden" name="_subject" value="Đơn đặt Commission mới từ website Linh Thuỳ!">
                <input type="hidden" name="_replyto" value="ptl31052010@gmail.com">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-cocoa/70 mb-1.5">Tên hoặc biệt danh của cậu *</label>
                        <input type="text" name="name" required placeholder="Tên để mình tiện xưng hô..." class="w-full px-4 py-2.5 rounded-2xl bg-white border border-pastel-200 focus:border-pastel-400 focus:outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-cocoa/70 mb-1.5">Đường dẫn Facebook / TikTok / Zalo liên hệ *</label>
                        <input type="text" name="contact" required placeholder="Đường dẫn liên hệ hoặc số điện thoại..." class="w-full px-4 py-2.5 rounded-2xl bg-white border border-pastel-200 focus:border-pastel-400 focus:outline-none text-sm">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-cocoa/70 mb-1.5">Gói vẽ &amp; Mức độ hoàn thiện *</label>
                    <input type="text" name="package" required placeholder="Ví dụ: Chibi loại 2 - Toàn thân - Rendered hoặc Normal ngang ngực..." class="w-full px-4 py-2.5 rounded-2xl bg-white border border-pastel-200 focus:border-pastel-400 focus:outline-none text-sm">
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-cocoa/70 mb-1.5">Mô tả chi tiết (Phong cách, ý tưởng, màu sắc, đường dẫn ảnh mẫu...) *</label>
                    <textarea name="brief" rows="4" required placeholder="Mô tả chi tiết phong cách, ý tưởng, màu sắc, đường dẫn ảnh mẫu nhân vật..." class="w-full px-4 py-2.5 rounded-2xl bg-white border border-pastel-200 focus:border-pastel-400 focus:outline-none text-sm"></textarea>
                </div>

                <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3">
                    <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 rounded-2xl bg-pastel-500 hover:bg-pastel-600 text-white font-display font-bold text-sm shadow-md transition-all hover:-translate-y-0.5 cursor-pointer">
                        <span>Hoàn tất ✨</span>
                    </button>
                    <p id="form-status" class="text-xs font-semibold text-pastel-600" aria-live="polite" role="status"></p>
                </div>
            </form>

            <!-- BACKUP CONTACT -->
            <div class="mt-8 pt-6 border-t border-pastel-100 text-xs sm:text-sm text-cocoa/85 space-y-1.5 bg-pastel-50/70 rounded-2xl p-4">
                <p class="font-semibold text-cocoa">Nếu bạn không liên hệ được qua Facebook bạn có thể liên hệ qua</p>
                <p>
                    <span class="font-bold text-pastel-600">Gmail:</span>
                    <button type="button" onclick="copyText('ptl31052010@gmail.com')" class="underline hover:text-pastel-500 cursor-pointer">ptl31052010@gmail.com</button>
                </p>
                <p>
                    <span class="font-bold text-pastel-600">Số điện thoại:</span>
                    <button type="button" onclick="copyText('0965753596')" class="underline hover:text-pastel-500 cursor-pointer">0965753596</button>
                </p>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="text-center text-xs text-cocoa/60 space-y-2 pt-2">
            <p class="pt-1">Made with ♡ for <span class="font-bold text-pastel-500">Linh Thuỳ</span></p>
            <p class="inline-flex items-center justify-center gap-1.5">
                <span>© 2026 LT's Art Corner • Ena. All rights reserved.</span>
                <button type="button" onclick="openPinModal()" title="Dành riêng cho Linh Thuỳ" aria-label="Mở khoá quản trị" class="opacity-35 hover:opacity-90 transition-opacity cursor-pointer text-[11px] px-1">
                    🔒
                </button>
            </p>
        </footer>
    </main>

    <!-- OWNER PIN MODAL -->
    <div id="pin-modal" class="hidden fixed inset-0 z-50 bg-cocoa/40 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-cream rounded-[2rem] p-6 w-full max-w-xs border-2 border-pastel-200 shadow-soft text-center space-y-4">
            <div class="w-12 h-12 rounded-full bg-pastel-100 text-pastel-500 flex items-center justify-center mx-auto text-lg">
                <i class="fa-solid fa-lock"></i>
            </div>
            <div>
                <h3 id="pin-modal-title" class="font-display text-lg font-bold text-cocoa">Xác nhận chủ trang</h3>
                <p id="pin-modal-desc" class="text-xs text-cocoa/70 mt-1">Nhập mã PIN của Linh Thuỳ để chỉnh trạng thái và bảng giá nhé ♡</p>
            </div>
            <div>
                <input id="pin-input" type="password" inputmode="numeric" maxlength="12" placeholder="Nhập mã PIN..." class="w-full px-4 py-2.5 rounded-2xl bg-white border border-pastel-200 focus:border-pastel-400 focus:outline-none text-center font-display font-bold tracking-widest text-sm">
                <p id="pin-error" class="hidden text-xs font-bold text-rose-500 mt-1.5">Mã PIN chưa đúng rồi cậu ơi!</p>
            </div>
            <div class="flex items-center gap-2 pt-1">
                <button type="button" onclick="closePinModal()" class="flex-1 py-2.5 rounded-2xl bg-pastel-50 hover:bg-pastel-100 text-cocoa/80 font-display font-bold text-xs cursor-pointer transition-colors">
                    Huỷ
                </button>
                <button type="button" onclick="submitPinModal()" class="flex-1 py-2.5 rounded-2xl bg-pastel-500 hover:bg-pastel-600 text-white font-display font-bold text-xs shadow-sm cursor-pointer transition-colors">
                    Xác nhận
                </button>
            </div>
        </div>
    </div>

    <!-- OWNER EDIT SINGLE PRICE MODAL -->
    <div id="price-edit-modal" class="hidden fixed inset-0 z-50 bg-cocoa/40 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-cream rounded-[2rem] p-6 w-full max-w-xs border-2 border-pastel-200 shadow-soft text-center space-y-4">
            <div class="w-12 h-12 rounded-full bg-pastel-100 text-pastel-500 flex items-center justify-center mx-auto text-lg">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <div>
                <h3 class="font-display text-lg font-bold text-cocoa">Chỉnh sửa mức giá</h3>
                <p id="price-edit-label" class="text-xs text-cocoa/70 mt-1">Nhập giá mới cho mục này (ví dụ: 65k, 120k...)</p>
            </div>
            <div>
                <input id="price-edit-input" type="text" maxlength="20" placeholder="Ví dụ: 50k" class="w-full px-4 py-2.5 rounded-2xl bg-white border border-pastel-200 focus:border-pastel-400 focus:outline-none text-center font-display font-bold text-sm text-pastel-600">
            </div>
            <div class="flex items-center gap-2 pt-1">
                <button type="button" onclick="closePriceEditModal()" class="flex-1 py-2.5 rounded-2xl bg-pastel-50 hover:bg-pastel-100 text-cocoa/80 font-display font-bold text-xs cursor-pointer transition-colors">
                    Huỷ
                </button>
                <button type="button" onclick="saveEditedPrice()" class="flex-1 py-2.5 rounded-2xl bg-pastel-500 hover:bg-pastel-600 text-white font-display font-bold text-xs shadow-sm cursor-pointer transition-colors">
                    Lưu giá
                </button>
            </div>
        </div>
    </div>

    <script>
        const STATUS_CONFIG = {
            open: { text: 'COMMISSION: OPEN 🌸', dot: 'bg-emerald-400 animate-ping' },
            waitlist: { text: 'COMMISSION: WAITLIST ⏳', dot: 'bg-amber-400 animate-pulse' },
            closed: { text: 'COMMISSION: CLOSED 💤', dot: 'bg-rose-400' }
        };

        const DEFAULT_PRICES = {
            c1_line: '30k', c1_flat: '45k', c1_rend: '60k',
            c2_hb_line: '25k', c2_hb_flat: '45k', c2_hb_rend: '65k',
            c2_fb_line: '40k', c2_fb_flat: '65k', c2_fb_rend: '85k',
            c3_bu_line: '30k', c3_bu_flat: '45k', c3_bu_rend: '60k',
            c3_hb_line: '40k', c3_hb_flat: '50k', c3_hb_rend: '75k',
            c3_fb_line: '55k', c3_fb_flat: '70k', c3_fb_rend: '110k',
            c4_hs_line: '25k', c4_hs_flat: '40k', c4_hs_rend: '60k',
            c4_bu_line: '35k', c4_bu_flat: '50k', c4_bu_rend: '75k',
            c4_hb_line: '45k', c4_hb_flat: '60k', c4_hb_rend: '80k',
            c4_ku_line: '60k', c4_ku_flat: '75k', c4_ku_rend: '110k',
            c4_fb_line: '75k', c4_fb_flat: '100k', c4_fb_rend: '160k',
            n_hs_line: '60k', n_hs_flat: '90k', n_hs_rend: '150k',
            n_bu_line: '80k', n_bu_flat: '120k', n_bu_rend: '180k',
            n_hb_line: '100k', n_hb_flat: '160k', n_hb_rend: '280k',
            n_ku_line: '150k', n_ku_flat: '200k', n_ku_rend: '280k',
            n_fb_line: '180k', n_fb_flat: '230k', n_fb_rend: '350k'
        };

        const STORAGE_STATUS_KEY = 'linhthuy_comm_status';
        const STORAGE_PRICES_KEY = 'linhthuy_comm_prices';
        const STORAGE_PIN_KEY = 'linhthuy_owner_pin';
        const SESSION_OWNER_KEY = 'linhthuy_owner_unlocked';
        const DEFAULT_PIN = '3105';

        let currentStatus = 'open';
        let currentPrices = { ...DEFAULT_PRICES };
        let pinModalMode = 'unlock';
        let activePriceKey = null;

        function isOwnerUnlocked() {
            try {
                return sessionStorage.getItem(SESSION_OWNER_KEY) === 'true';
            } catch {
                return false;
            }
        }

        function getOwnerPin() {
            try {
                return localStorage.getItem(STORAGE_PIN_KEY) || DEFAULT_PIN;
            } catch {
                return DEFAULT_PIN;
            }
        }

        function encodePricesToParam(pricesObj) {
            try {
                const diffs = {};
                Object.keys(DEFAULT_PRICES).forEach(k => {
                    if (pricesObj[k] && pricesObj[k] !== DEFAULT_PRICES[k]) {
                        diffs[k] = pricesObj[k];
                    }
                });
                if (Object.keys(diffs).length === 0) return '';
                const json = JSON.stringify(diffs);
                return btoa(unescape(encodeURIComponent(json)));
            } catch {
                return '';
            }
        }

        function decodePricesFromParam(paramStr) {
            try {
                if (!paramStr) return null;
                const json = decodeURIComponent(escape(atob(paramStr)));
                const parsed = JSON.parse(json);
                return parsed && typeof parsed === 'object' ? parsed : null;
            } catch {
                return null;
            }
        }

        function renderAllPrices() {
            const unlocked = isOwnerUnlocked();
            document.querySelectorAll('.price-cell').forEach(el => {
                const key = el.getAttribute('data-price-key');
                if (!key) return;
                el.textContent = currentPrices[key] || DEFAULT_PRICES[key] || '';
                if (unlocked) {
                    el.classList.add('cursor-pointer', 'underline', 'decoration-dotted', 'decoration-pastel-400', 'bg-pastel-50', 'px-2', 'py-0.5', 'rounded-lg', 'hover:bg-pastel-100', 'transition-colors');
                    el.title = 'Bấm để sửa giá này';
                } else {
                    el.classList.remove('cursor-pointer', 'underline', 'decoration-dotted', 'decoration-pastel-400', 'bg-pastel-50', 'px-2', 'py-0.5', 'rounded-lg', 'hover:bg-pastel-100', 'transition-colors');
                    el.removeAttribute('title');
                }
            });

            const badge = document.getElementById('price-mode-badge');
            if (badge) {
                badge.textContent = unlocked
                    ? 'Chế độ chỉnh sửa: Bấm vào giá để đổi • Đơn vị: VNĐ'
                    : 'Bảng giá cố định • Đơn vị: VNĐ';
            }
        }

        function applyStatusUI(statusKey) {
            const key = STATUS_CONFIG[statusKey] ? statusKey : 'open';
            currentStatus = key;
            const cfg = STATUS_CONFIG[key];
            const textEl = document.getElementById('status-text');
            const dotEl = document.getElementById('status-dot');
            if (textEl) textEl.textContent = cfg.text;
            if (dotEl) dotEl.className = 'w-2.5 h-2.5 rounded-full ' + cfg.dot;

            ['open', 'waitlist', 'closed'].forEach(k => {
                const btn = document.getElementById('owner-btn-' + k);
                if (!btn) return;
                if (k === key) {
                    btn.className = 'px-3.5 py-1.5 rounded-full text-xs font-display font-bold border transition-all cursor-pointer bg-pastel-500 border-pastel-500 text-white shadow-sm';
                } else {
                    btn.className = 'px-3.5 py-1.5 rounded-full text-xs font-display font-bold border transition-all cursor-pointer bg-white border-pastel-200 text-cocoa hover:bg-pastel-50';
                }
            });
        }

        function initAppState() {
            try {
                const params = new URLSearchParams(window.location.search);
                const urlStatus = (params.get('status') || '').toLowerCase();
                const savedStatus = localStorage.getItem(STORAGE_STATUS_KEY);

                if (STATUS_CONFIG[urlStatus]) {
                    applyStatusUI(urlStatus);
                } else if (savedStatus && STATUS_CONFIG[savedStatus]) {
                    applyStatusUI(savedStatus);
                } else {
                    applyStatusUI('open');
                }

                // Load prices: URL param takes precedence for visitors, else localStorage, else defaults
                const urlPrices = decodePricesFromParam(params.get('prices'));
                const savedPricesRaw = localStorage.getItem(STORAGE_PRICES_KEY);
                const savedPrices = savedPricesRaw ? JSON.parse(savedPricesRaw) : null;

                currentPrices = {
                    ...DEFAULT_PRICES,
                    ...(savedPrices || {}),
                    ...(urlPrices || {})
                };

                if (isOwnerUnlocked()) {
                    document.getElementById('owner-panel')?.classList.remove('hidden');
                }
            } catch {
                applyStatusUI('open');
                currentPrices = { ...DEFAULT_PRICES };
            }
            renderAllPrices();
        }

        function setStatus(newStatus) {
            if (!STATUS_CONFIG[newStatus] || !isOwnerUnlocked()) return;
            applyStatusUI(newStatus);
            try {
                localStorage.setItem(STORAGE_STATUS_KEY, newStatus);
            } catch {}
            showToast('Đã đổi trạng thái sang ' + STATUS_CONFIG[newStatus].text);
        }

        function copyShareableConfigLink() {
            try {
                const url = new URL(window.location.href);
                url.searchParams.set('status', currentStatus);
                const encodedPrices = encodePricesToParam(currentPrices);
                if (encodedPrices) {
                    url.searchParams.set('prices', encodedPrices);
                } else {
                    url.searchParams.delete('prices');
                }
                copyText(url.toString());
            } catch {
                const base = window.location.href.split('?')[0].split('#')[0];
                const encodedPrices = encodePricesToParam(currentPrices);
                const suffix = encodedPrices ? `&prices=${encodeURIComponent(encodedPrices)}` : '';
                copyText(`${base}?status=${currentStatus}${suffix}`);
            }
        }

        // Price cell click handler (Owner only)
        document.getElementById('price-container')?.addEventListener('click', (e) => {
            const cell = e.target.closest('.price-cell');
            if (!cell || !isOwnerUnlocked()) return;
            const key = cell.getAttribute('data-price-key');
            if (!key) return;
            activePriceKey = key;
            const input = document.getElementById('price-edit-input');
            input.value = currentPrices[key] || '';
            document.getElementById('price-edit-modal').classList.remove('hidden');
            setTimeout(() => {
                input.focus();
                input.select();
            }, 50);
        });

        function closePriceEditModal() {
            document.getElementById('price-edit-modal').classList.add('hidden');
            activePriceKey = null;
        }

        function saveEditedPrice() {
            if (!activePriceKey || !isOwnerUnlocked()) return;
            const val = (document.getElementById('price-edit-input').value || '').trim();
            if (!val) {
                showToast('Vui lòng nhập mức giá hợp lệ!');
                return;
            }
            currentPrices[activePriceKey] = val;
            try {
                localStorage.setItem(STORAGE_PRICES_KEY, JSON.stringify(currentPrices));
            } catch {}
            renderAllPrices();
            closePriceEditModal();
            showToast('Đã cập nhật giá thành ' + val + ' ♡');
        }

        function resetDefaultPrices() {
            if (!isOwnerUnlocked()) return;
            currentPrices = { ...DEFAULT_PRICES };
            try {
                localStorage.removeItem(STORAGE_PRICES_KEY);
            } catch {}
            renderAllPrices();
            showToast('Đã khôi phục toàn bộ bảng giá gốc!');
        }

        document.getElementById('price-edit-input')?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                saveEditedPrice();
            } else if (e.key === 'Escape') {
                closePriceEditModal();
            }
        });

        // Owner PIN Modal controls
        function openPinModal() {
            if (isOwnerUnlocked()) {
                document.getElementById('owner-panel')?.classList.remove('hidden');
                document.getElementById('owner-panel')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
            pinModalMode = 'unlock';
            document.getElementById('pin-modal-title').textContent = 'Xác nhận chủ trang';
            document.getElementById('pin-modal-desc').textContent = 'Nhập mã PIN của Linh Thuỳ để chỉnh trạng thái và bảng giá nhé ♡';
            const input = document.getElementById('pin-input');
            input.value = '';
            input.placeholder = 'Nhập mã PIN...';
            document.getElementById('pin-error').classList.add('hidden');
            document.getElementById('pin-modal').classList.remove('hidden');
            setTimeout(() => input.focus(), 50);
        }

        function openChangePinModal() {
            if (!isOwnerUnlocked()) return;
            pinModalMode = 'change';
            document.getElementById('pin-modal-title').textContent = 'Đổi mã PIN quản trị';
            document.getElementById('pin-modal-desc').textContent = 'Nhập mã PIN mới (4-12 số) để bảo vệ quyền chỉnh sửa của bạn:';
            const input = document.getElementById('pin-input');
            input.value = '';
            input.placeholder = 'Nhập mã PIN mới...';
            document.getElementById('pin-error').classList.add('hidden');
            document.getElementById('pin-modal').classList.remove('hidden');
            setTimeout(() => input.focus(), 50);
        }

        function closePinModal() {
            document.getElementById('pin-modal').classList.add('hidden');
        }

        function submitPinModal() {
            const input = document.getElementById('pin-input');
            const errEl = document.getElementById('pin-error');
            const val = (input.value || '').trim();

            if (pinModalMode === 'unlock') {
                if (val === getOwnerPin()) {
                    try {
                        sessionStorage.setItem(SESSION_OWNER_KEY, 'true');
                    } catch {}
                    closePinModal();
                    const panel = document.getElementById('owner-panel');
                    panel?.classList.remove('hidden');
                    renderAllPrices();
                    panel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    showToast('Chào Linh Thuỳ! Đã mở khoá chỉnh trạng thái và bảng giá ♡');
                } else {
                    errEl.textContent = 'Mã PIN chưa đúng rồi cậu ơi!';
                    errEl.classList.remove('hidden');
                }
            } else if (pinModalMode === 'change') {
                if (val.length < 4) {
                    errEl.textContent = 'Mã PIN cần ít nhất 4 ký tự nhé!';
                    errEl.classList.remove('hidden');
                    return;
                }
                try {
                    localStorage.setItem(STORAGE_PIN_KEY, val);
                } catch {}
                closePinModal();
                showToast('Đã cập nhật mã PIN mới thành công!');
            }
        }

        function lockOwnerMode() {
            try {
                sessionStorage.removeItem(SESSION_OWNER_KEY);
            } catch {}
            document.getElementById('owner-panel')?.classList.add('hidden');
            renderAllPrices();
            showToast('Đã khoá chế độ chủ trang 🔒');
        }

        document.getElementById('pin-input')?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitPinModal();
            } else if (e.key === 'Escape') {
                closePinModal();
            }
        });

        document.getElementById('secret-sparkle')?.addEventListener('dblclick', openPinModal);

        function showToast(message) {
            const toast = document.getElementById('toast');
            const msg = document.getElementById('toast-msg');
            msg.textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2200);
        }

        function fallbackCopy(text) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            tempInput.setAttribute('readonly', '');
            tempInput.style.position = 'absolute';
            tempInput.style.left = '-9999px';
            document.body.appendChild(tempInput);
            tempInput.select();
            try {
                document.execCommand('copy');
            } catch {}
            document.body.removeChild(tempInput);
        }

        function copyText(text) {
            if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
                navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
            } else {
                fallbackCopy(text);
            }
            showToast('Đã sao chép: ' + text);
        }

        function showPage(sectionId) {
            document.getElementById('home-menu').classList.add('hidden');
            ['price-section', 'tos-section', 'order-section'].forEach(id => {
                document.getElementById(id).classList.toggle('hidden', id !== sectionId);
            });
            document.getElementById(sectionId).scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function showHome() {
            ['price-section', 'tos-section', 'order-section'].forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });
            document.getElementById('home-menu').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function filterPrices(type) {
            const chibi = document.getElementById('block-chibi');
            const normal = document.getElementById('block-normal');
            chibi.classList.toggle('hidden', type === 'normal');
            normal.classList.toggle('hidden', type === 'chibi');

            document.querySelectorAll('.filter-tab').forEach(btn => {
                btn.classList.remove('bg-white', 'text-pastel-600', 'shadow-sm');
                btn.classList.add('text-cocoa/70');
            });
            const active = document.getElementById('tab-' + type);
            active.classList.add('bg-white', 'text-pastel-600', 'shadow-sm');
            active.classList.remove('text-cocoa/70');
        }

        const form = document.getElementById('comm-form');
        const statusEl = document.getElementById('form-status');
        form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            statusEl.textContent = 'Đang gửi thông báo về Gmail...';
            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'Accept': 'application/json' }
                });
                if (res.ok) {
                    statusEl.textContent = 'Hoàn tất rồi! Thông báo đơn đã gửi về Gmail của cậu nhé ♡';
                    form.reset();
                } else {
                    statusEl.textContent = 'Có lỗi khi gửi biểu mẫu, cậu thử gửi lại hoặc kiểm tra cấu hình Formspree của ptl31052010@gmail.com nha!';
                }
            } catch {
                statusEl.textContent = 'Không kết nối được mạng, cậu thử lại sau nhé!';
            }
        });

        initAppState();
    </script>
</body>
</html>
